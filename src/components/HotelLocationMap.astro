---
import { getHotelMapUrls, type HotelLocationMapData } from "../utils/hotelLocationMap";

interface Props extends HotelLocationMapData {}

const { title, location = "", airportDriveTime = "", nearbyHighlights = "" } = Astro.props;
const { embedUrl, directionsUrl } = getHotelMapUrls({ title, location });
---

<section
  class="hotel-location-map container-editorial pb-20 md:pb-28"
  data-hotel-location-map
  data-hotel-name={title}
  data-hotel-location={location}
  data-hotel-airport-drive-time={airportDriveTime}
  data-hotel-nearby-highlights={nearbyHighlights}
>
  <div class="max-w-3xl border border-forest/15 bg-white p-5 shadow-sm sm:p-7">
    <h2 class="font-display text-3xl text-forest">Location & Nearby</h2>
    <p class="hotel-location-address mt-2 text-sm text-stone-500">{location || title}</p>

    <div class="mt-5 h-56 overflow-hidden border border-forest/10 bg-sand sm:h-64">
      <iframe
        class="hotel-location-iframe h-full w-full border-0"
        src={embedUrl}
        title={`Map showing ${title}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-forest/10 pt-4 text-sm text-stone-600">
      <p class="hotel-airport-info flex items-center gap-2">
        <span aria-hidden="true">✈️</span>
        {airportDriveTime
          ? `Approx. ${airportDriveTime} drive from Ngurah Rai International Airport (DPS)`
          : "View the route and estimated driving time from Ngurah Rai International Airport (DPS)"}
      </p>
      <p class="hotel-highlights-info flex items-center gap-2" hidden={Boolean(!nearbyHighlights)}>
        <span aria-hidden="true">📍</span>
        {nearbyHighlights}
      </p>
    </div>

    <a
      class="hotel-directions-link mt-5 inline-flex border-b border-forest/40 pb-2 text-[10px] tracking-widest text-forest transition-colors hover:border-forest hover:text-gold"
      href={directionsUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      VIEW ROUTE FROM THE AIRPORT ↗
    </a>
  </div>
</section>
