---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = "VIEW ALL",
} = Astro.props;
---

<div class="mb-8 flex flex-col justify-between gap-5 md:mb-12 md:flex-row md:items-end">
  <div>
    <p class="mb-4 text-[10px] tracking-[0.25em] text-stone-500">
      {eyebrow}
    </p>
    <h2 class="editorial-title max-w-3xl text-5xl md:text-7xl">
      {title}
    </h2>
    {description && (
      <p class="mt-5 max-w-xl text-sm leading-7 text-stone-600">
        {description}
      </p>
    )}
  </div>

  {href && (
    <a
      href={href}
      class="shrink-0 border-b border-forest/40 pb-2 text-[10px] tracking-widest"
    >
      {linkLabel} ↗
    </a>
  )}
</div>