---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | Tria Uma">
  <section class="container-editorial flex min-h-[75svh] flex-col items-start justify-center">
    <p class="text-xs tracking-[0.25em] text-stone-500">404 — PAGE NOT FOUND</p>
    <h1 class="editorial-title mt-6 text-7xl md:text-9xl">Lost your way?</h1>
    <p class="mt-6 text-sm text-stone-600">Let's take you somewhere wonderful.</p>
    <a href="/" class="mt-8 border-b border-forest pb-3 text-xs tracking-widest">
      RETURN HOME ↗
    </a>
  </section>
</BaseLayout>
