---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";

const faqs = [
  {
    question: "Can I customise my itinerary completely?",
    answer: "Absolutely. Every journey we arrange is built around you — your dates, your preferred hotels, your chosen activities, your pace. Use our interactive itinerary builder or speak directly with our specialists.",
  },
  {
    question: "Can I request a specific hotel or villa?",
    answer: "Yes. Tell us your preferred property and travel dates. Our team will confirm availability and negotiate the best inclusions on your behalf.",
  },
  {
    question: "What services does Tria Uma provide?",
    answer: "We handle everything: airport transfers (IN/OUT), private chauffeur vehicles (Alphard, Innova Zenix, HiAce VIP), full-day and half-day tours, activity bookings, hotel reservations, fast-track airport assistance, and bespoke day programs.",
  },
  {
    question: "How do I receive a travel proposal?",
    answer: "Build your itinerary using our interactive planner and submit it directly to our reservation team via WhatsApp — or contact us through the contact page and we'll prepare a personalised PDF proposal for you.",
  },
  {
    question: "Is there a price shown on the itinerary builder?",
    answer: "No prices are shown in the builder. All itineraries are submitted as 'Quotation on Request' and our reservation team will follow up with a full costed proposal based on your selections.",
  },
  {
    question: "How far in advance should I book?",
    answer: "We recommend booking at least 2–4 weeks in advance, especially during peak seasons (June–August, December). For high-demand villas and special events, earlier is always better.",
  },
  {
    question: "Do you handle group travel?",
    answer: "Yes. We manage group travel of all sizes — from couples to large corporate incentive groups — with dedicated vehicles, group dining reservations, and coordinated multi-day programs.",
  },
];

const contacts = [
  { icon: "📱", label: "WhatsApp", value: "+62 812 3456 7890", href: "https://wa.me/6281234567890" },
  { icon: "✉️", label: "Email", value: "hello@triauma.com", href: "mailto:hello@triauma.com" },
  { icon: "📍", label: "Office", value: "Jl. Raya Ubud No. 1, Bali 80571" },
];
---

<BaseLayout
  title="About Us | Tria Uma"
  description="Learn about Tria Uma — our philosophy, services, team, and answers to frequently asked questions about traveling with us."
>
  <Hero
    compact
    eyebrow="ABOUT TRIA UMA"
    title="Travel is personal."
    subtitle="We believe the finest journeys begin with truly understanding what matters to you."
    image="https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=2200&q=85"
  />

  <!-- Philosophy -->
  <section class="container-editorial grid gap-10 py-20 md:grid-cols-2 md:py-32">
    <h2 class="about-philosophy-title editorial-title text-5xl md:text-7xl">
      Our philosophy
    </h2>
    <div class="about-philosophy-paragraphs space-y-6 text-sm leading-8 text-stone-600">
      <p>
        Every traveller has a different idea of what makes a journey unforgettable. Our approach begins with listening, understanding, and creating experiences around those individual wishes — not off-the-shelf packages.
      </p>
      <p>
        From exceptional hotels to meaningful cultural encounters, every detail of your itinerary is shaped around you. That is why we call it <em>Simple, Quality & Satisfaction</em>.
      </p>
      <a href="/contact/" class="inline-block border-b border-forest/40 pb-2 text-xs tracking-widest hover:border-gold hover:text-gold transition-colors">
        GET IN TOUCH ↗
      </a>
    </div>
  </section>

  <!-- What We Do -->
  <section class="bg-sand/30 border-t border-b border-forest/10 py-16 md:py-24">
    <div class="container-editorial">
      <p class="text-xs tracking-[0.25em] text-stone-500 mb-3">WHAT WE DO</p>
      <h2 class="editorial-title text-4xl md:text-6xl text-forest max-w-2xl mb-12">
        Your end-to-end Bali travel partner.
      </h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: "🚗", title: "Private Transfers", body: "Airport pickups and drop-offs in premium vehicles — Alphard, Innova Zenix, or HiAce VIP." },
          { icon: "🗺️", title: "Full & Half Day Tours", body: "Guided cultural, adventure, and culinary tours fully customised to your group's interests." },
          { icon: "🏨", title: "Hotel Reservations", body: "Curated partner hotels, private villas, and boutique retreats across Bali and beyond." },
          { icon: "✈️", title: "Airport Fast Track", body: "VIP immigration and baggage assistance so you clear the airport in style and without the queue." },
          { icon: "📋", title: "Bespoke Itineraries", body: "Day-by-day planning using our interactive builder — submit as a PDF proposal for instant quoting." },
          { icon: "🎉", title: "Events & Groups", body: "Incentive travel, honeymoon arrangements, family reunions, and special occasion programs." },
        ].map((s) => (
          <div class="border border-forest/15 bg-white p-6 hover:border-forest/40 transition-colors">
            <span class="text-2xl block mb-3">{s.icon}</span>
            <h3 class="font-display text-lg text-forest mb-2">{s.title}</h3>
            <p class="text-xs text-stone-600 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Details -->
  <section class="container-editorial py-16 md:py-24">
    <div class="grid gap-12 md:grid-cols-2 items-start">
      <div>
        <p class="text-xs tracking-[0.25em] text-stone-500 mb-3">CONTACT & RESERVATION</p>
        <h2 class="editorial-title text-4xl md:text-6xl text-forest max-w-xl">
          Let's plan something extraordinary.
        </h2>
        <p class="text-sm text-stone-600 leading-8 mt-5 max-w-md">
          Tell us where you'd like to go, what inspires you, and how you want to experience the world — we'll handle everything else.
        </p>
     <a
        href="/plan-your-journey/"
        class="hidden border border-forest/70 px-5 py-3 text-[10px]
               tracking-[0.15em] transition-colors duration-300
               hover:bg-white hover:text-forest md:inline-flex"
      >
        PLAN YOUR JOURNEY ↗
      </a>
      </div>
      <div class="space-y-5">
        <div class="flex items-start gap-4 border-b border-forest/10 pb-5">
          <span class="text-xl mt-0.5">📱</span>
          <div>
            <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Reservation WhatsApp</p>
            <a id="about-contact-whatsapp" href="https://wa.me/6281234567890" target="_blank" class="text-sm text-forest hover:text-gold transition-colors font-medium">+62 812 3456 7890</a>
          </div>
        </div>
        <div class="flex items-start gap-4 border-b border-forest/10 pb-5">
          <span class="text-xl mt-0.5">✉️</span>
          <div>
            <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Reservation Email</p>
            <a id="about-contact-email" href="mailto:reservation@triauma.com" class="text-sm text-forest hover:text-gold transition-colors font-medium">reservation@triauma.com</a>
          </div>
        </div>
        <div class="flex items-start gap-4 border-b border-forest/10 pb-5">
          <span class="text-xl mt-0.5">☎️</span>
          <div>
            <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Telephone</p>
            <p id="about-contact-phone" class="text-sm text-forest font-medium">+62 361 987 654</p>
          </div>
        </div>
        <div class="flex items-start gap-4 border-b border-forest/10 pb-5">
          <span class="text-xl mt-0.5">🕘</span>
          <div>
            <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Office Hours</p>
            <p id="about-contact-hours" class="text-sm text-stone-700">Monday – Sunday, 08:00 – 20:00 WITA</p>
          </div>
        </div>
        <div class="flex items-start gap-4 border-b border-forest/10 pb-5">
          <span class="text-xl mt-0.5">📍</span>
          <div>
            <p class="text-[10px] tracking-widest text-stone-400 uppercase mb-1">Physical Address</p>
            <p id="about-contact-address" class="text-sm text-stone-700">Jl. Danau Tamblingan No. 88, Sanur, Bali 80228, Indonesia</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-sand/20 border-t border-forest/10 py-16 md:py-24" id="faq">
    <div class="container-editorial max-w-3xl">
      <p class="text-xs tracking-[0.25em] text-stone-500 mb-3">HELP & INFORMATION</p>
      <h2 class="editorial-title text-4xl md:text-6xl text-forest mb-12">
        Frequently asked questions.
      </h2>
      <div class="space-y-0">
        {faqs.map((faq) => (
          <details class="group border-b border-stone-200 py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-sm font-medium text-forest">
              <span>{faq.question}</span>
              <span class="text-xl transition-transform group-open:rotate-45 shrink-0 text-gold">+</span>
            </summary>
            <p class="max-w-2xl pt-4 text-sm leading-7 text-stone-600">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
      <div class="mt-10 pt-6 border-t border-forest/10">
        <p class="text-xs text-stone-500">Still have questions?</p>
        <a href="/contact/" class="text-sm text-forest hover:text-gold transition-colors font-medium inline-flex items-center gap-1 mt-1">
          Contact our team ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
