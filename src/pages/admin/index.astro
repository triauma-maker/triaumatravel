  // ==========================================
  // Settings Tab Handling (Password & Backup)
  // ==========================================
  function loadSettingsTab() {
    const passwordInput = document.getElementById("setting-new-password") as HTMLInputElement | null;
    if (passwordInput) passwordInput.value = "";
  }

  document.getElementById("form-change-password")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const newPass = (document.getElementById("setting-new-password") as HTMLInputElement).value;
    try {
      await updateAdminPassword(newPass);
      (document.getElementById("setting-new-password") as HTMLInputElement).value = "";
      showToast("Admin password updated successfully!");
    } catch (error) {
      console.error("Could not update admin password:", error);
      showToast(error instanceof Error ? error.message : "Could not update admin password.");
    }
  });

  // Export All Content JSON
  document.getElementById("btn-export-all-json")?.addEventListener("click", () => {
    const exportBundle = {
      exportedAt: new Date().toISOString(),
      siteContent: getSiteContent(),
      itineraryElements: getAdminElements(),
      contactSettings: getContactSettings(),
    };
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportBundle, null, 2));
    const a = document.createElement("a");
    a.href = dataStr;
    a.download = `tria-uma-cms-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    showToast("Content exported to JSON!");
  });

  // Import JSON File
  document.getElementById("input-import-json")?.addEventListener("change", (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = async (event) => {
      try {
        const parsed = JSON.parse(event.target?.result as string);
        if (parsed.siteContent) {
          await saveSiteContent(parsed.siteContent);
          siteContent = parsed.siteContent;
        }
        if (parsed.itineraryElements) {
          await saveAdminElements(parsed.itineraryElements);
          itineraryElements = parsed.itineraryElements;
        }
        if (parsed.contactSettings) {
          await saveContactSettings(parsed.contactSettings);
        }
        renderCurrentView();
        showToast("Content restored successfully from file!");
      } catch (err) {
        console.error("Failed to restore CMS backup:", err);
        alert(err instanceof Error ? `Restore failed: ${err.message}` : "Failed to parse JSON backup file.");
      }
    };
    reader.readAsText(file);
  });

  // Reset All to Defaults
  document.getElementById("btn-reset-all-site")?.addEventListener("click", async () => {
    if (!confirm("Are you sure you want to reset all website content and itinerary elements back to original Tria Uma defaults?")) return;
    try {
      [siteContent, itineraryElements] = await Promise.all([
        resetSiteContentToDefault(),
        resetAdminElementsToDefault(),
      ]);
      renderCurrentView();
      showToast("All content reset to original defaults!");
    } catch (error) {
      console.error("Could not reset CMS data:", error);
      showToast(error instanceof Error ? `Reset failed: ${error.message}` : "Could not reset CMS data.");
    }
  });

