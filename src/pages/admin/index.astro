---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Admin Dashboard & Content Management System | Tria Uma"
  description="Manage all website content, hero sections, hotels, stories, travel plans, and custom itinerary builder elements."
>
  <!-- LOGIN VIEW (Shown when unauthenticated) -->
  <section id="admin-login-view" class="min-h-[85vh] flex items-center justify-center py-32 px-4 bg-forest relative overflow-hidden">
    <div class="absolute inset-0 opacity-15 pointer-events-none">
      <img
        src="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>

    <div class="bg-ivory border border-forest/20 shadow-2xl max-w-md w-full p-8 md:p-10 relative z-10 text-center">
      <span class="text-[9px] tracking-[0.35em] uppercase text-gold font-semibold block mb-2">TRIA UMA MANAGEMENT</span>
      <h1 class="font-display text-3xl md:text-4xl text-forest">Admin Dashboard</h1>
      <p class="text-xs text-stone-600 mt-2 mb-6 leading-relaxed">
        Sign in to edit all website content, manage hotels, stories, experiences, and custom itinerary elements.
      </p>

      <div id="login-error-msg" class="hidden mb-4 p-3 bg-red-100 border border-red-300 text-red-700 text-xs">
        Could not sign in. Please check your Supabase admin credentials.
      </div>

      <form id="admin-login-form" class="space-y-4 text-left">
        <div>
          <label class="block text-[10px] uppercase tracking-widest text-forest font-semibold mb-1">
            Email address
          </label>
          <input
            type="email"
            id="login-email"
            required
            autocomplete="email"
            class="w-full border border-forest/20 p-3 text-xs bg-white focus:outline-none focus:border-forest"
            placeholder="Admin email address"
          />
        </div>

        <div>
          <label class="block text-[10px] uppercase tracking-widest text-forest font-semibold mb-1">
            Password
          </label>
          <input
            type="password"
            id="login-password"
            required
            autocomplete="current-password"
            class="w-full border border-forest/20 p-3 text-xs bg-white focus:outline-none focus:border-forest"
            placeholder="Password"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-forest text-white py-3.5 px-4 text-xs tracking-widest uppercase font-semibold hover:bg-forest/90 transition-colors shadow-md mt-2"
        >
          LOG IN TO DASHBOARD
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-forest/15 text-[11px] text-stone-500">
        Sign in using the admin account configured in Supabase.
      </div>
    </div>
  </section>

  <!-- DASHBOARD MAIN VIEW (Shown when authenticated) -->
  <div id="admin-dashboard-view" class="hidden">
    <!-- Top Admin Header -->
    <div class="bg-forest pt-36 pb-12 text-white border-b border-white/10">
      <div class="container-editorial">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[10px] tracking-[0.3em] uppercase text-gold font-medium">CONTENT MANAGEMENT & CONTROL</span>
              <span class="bg-white/10 text-[9px] px-2 py-0.5 border border-white/20 font-mono text-white/80">CMS v2.0</span>
            </div>
            <h1 class="editorial-title text-4xl md:text-6xl mt-1">Website & Itinerary Admin</h1>
            <p class="text-white/70 max-w-2xl text-xs md:text-sm mt-3 leading-relaxed">
              Edit all website content (Homepage, Hotels, Journal Stories, Plans, Offers, FAQs, Contact Info) and configure elements for the bespoke custom itinerary builder.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/"
              target="_blank"
              class="border border-white/30 text-white hover:border-white px-3.5 py-2 text-[10px] tracking-widest uppercase transition-colors inline-flex items-center gap-1.5"
            >
              <span>VIEW WEBSITE</span>
              <span>↗</span>
            </a>
            <a
              href="/plan-your-journey/"
              target="_blank"
              class="border border-gold text-gold hover:bg-gold hover:text-forest px-3.5 py-2 text-[10px] tracking-widest uppercase transition-colors inline-flex items-center gap-1.5"
            >
              <span>PREVIEW PLANNER</span>
              <span>↗</span>
            </a>
            <button
              id="btn-admin-logout"
              class="bg-red-500/20 border border-red-400/40 text-red-200 hover:bg-red-500 hover:text-white px-3.5 py-2 text-[10px] tracking-widest uppercase transition-colors"
            >
              LOG OUT ⏻
            </button>
          </div>
        </div>

        <!-- Section Navigation Switcher -->
        <div class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-white/15">
          <button
            data-section="website-content"
            class="section-btn px-4 py-2 text-xs tracking-widest uppercase font-semibold border transition-all border-gold bg-gold text-forest shadow-sm"
          >
            🌐 WEBSITE CONTENT CMS
          </button>
          <button
            data-section="itinerary-elements"
            class="section-btn px-4 py-2 text-xs tracking-widest uppercase font-semibold border transition-all border-white/20 text-white/70 hover:border-white hover:text-white"
          >
            🧭 CUSTOM ITINERARY BUILDER
          </button>
          <button
            data-section="site-settings"
            class="section-btn px-4 py-2 text-xs tracking-widest uppercase font-semibold border transition-all border-white/20 text-white/70 hover:border-white hover:text-white"
          >
            ⚙️ SETTINGS & DATA TOOLS
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN BODY SECTIONS -->
    <section class="container-editorial py-10 md:py-16">

      <!-- SECTION 1: WEBSITE CONTENT CMS -->
      <div id="section-website-content" class="cms-section">
        <!-- Sub Tabs -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-forest/15 pb-4 mb-8">
          <div class="flex flex-wrap gap-2" id="website-subtabs">
            <button data-wtab="general" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest bg-forest text-white font-medium">
              🏠 Homepage & Hero
            </button>
            <button data-wtab="events" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              📅 Calendar Events
            </button>
            <button data-wtab="hotels" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🏨 Featured Hotels
            </button>
            <button data-wtab="journal" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              📖 Journal Stories
            </button>
            <button data-wtab="plans" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🗺️ Signature Plans
            </button>
            <button data-wtab="offers" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🎁 Special Offers
            </button>
            <button data-wtab="experiences" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🧭 Experiences
            </button>
            <button data-wtab="faqs" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              ❓ FAQs
            </button>
            <button data-wtab="about" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🏛️ About & Philosophy
            </button>
            <button data-wtab="contact" class="wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest">
              📞 Contact Channels
            </button>
          </div>

          <button
            id="btn-add-website-item"
            class="bg-forest text-white px-4 py-2 text-xs tracking-wider uppercase font-medium hover:bg-forest/90 transition-colors"
          >
            + ADD NEW ITEM
          </button>
        </div>

        <!-- Dynamic Content Display Container -->
        <div id="website-content-panel">
          <!-- Populated dynamically via JS -->
        </div>
      </div>

      <!-- SECTION 2: ITINERARY ELEMENTS (HOTELS, ACTIVITIES, VEHICLES, SERVICES, DAY TEMPLATES) -->
      <div id="section-itinerary-elements" class="cms-section hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-forest/15 pb-4 mb-8">
          <div class="flex flex-wrap gap-2" id="itinerary-tabs">
            <button data-itab="hotels" class="itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest bg-forest text-white font-medium">
              🏨 Itinerary Hotels
            </button>
            <button data-itab="activities" class="itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🏄 Activities
            </button>
            <button data-itab="vehicles" class="itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🚗 Chauffeur Vehicles
            </button>
            <button data-itab="services" class="itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🛎️ Services
            </button>
            <button data-itab="templates" class="itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest/20 text-forest/70 hover:border-forest">
              🗓️ Day Suggestions
            </button>
          </div>

          <button
            id="btn-add-itinerary-element"
            class="bg-forest text-white px-5 py-2.5 text-xs tracking-widest uppercase font-medium hover:bg-forest/90 transition-colors"
          >
            + ADD ELEMENT
          </button>
        </div>

        <div id="itinerary-items-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- SECTION 3: SETTINGS & DATA TOOLS -->
      <div id="section-site-settings" class="cms-section hidden">
        <div class="max-w-3xl mx-auto space-y-10">

          <!-- Admin Password Setting -->
          <div class="bg-white border border-forest/15 p-6 md:p-8 shadow-sm">
            <h3 class="font-display text-2xl text-forest mb-1">Admin Security & Password</h3>
            <p class="text-xs text-stone-600 mb-6 leading-relaxed">
              Change the password for your authenticated Supabase admin account.
            </p>

            <form id="form-change-password" class="space-y-4 max-w-md">
              <div>
                <label class="block text-[11px] uppercase tracking-wider text-forest font-medium mb-1">New Password</label>
                <input type="password" id="setting-new-password" required minlength="8" autocomplete="new-password" class="w-full border border-forest/20 p-2.5 text-xs bg-ivory focus:bg-white focus:outline-none focus:border-forest" />
              </div>
              <button type="submit" class="bg-forest text-white px-5 py-2.5 text-xs tracking-widest uppercase font-medium hover:bg-forest/90 transition-colors">
                UPDATE PASSWORD
              </button>
            </form>
          </div>

          <!-- Backup & Restore JSON -->
          <div class="bg-white border border-forest/15 p-6 md:p-8 shadow-sm">
            <h3 class="font-display text-2xl text-forest mb-1">Backup & Restore Entire Website Data</h3>
            <p class="text-xs text-stone-600 mb-6 leading-relaxed">
              Export all customized website content, stories, hotels, and itinerary elements into a single JSON file. You can restore it anytime or transfer it to another browser.
            </p>

            <div class="flex flex-wrap gap-4 items-center">
              <button id="btn-export-all-json" class="border border-forest text-forest hover:bg-forest hover:text-white px-5 py-2.5 text-xs tracking-widest uppercase font-medium transition-colors">
                📥 EXPORT ALL CONTENT JSON
              </button>
              
              <label class="cursor-pointer bg-forest text-white hover:bg-forest/90 px-5 py-2.5 text-xs tracking-widest uppercase font-medium transition-colors inline-block">
                📤 IMPORT FROM JSON
                <input type="file" id="input-import-json" accept=".json" class="hidden" />
              </label>

              <button id="btn-reset-all-site" class="border border-red-300 text-red-600 hover:bg-red-50 px-5 py-2.5 text-xs tracking-widest uppercase transition-colors">
                ⚠️ RESET ALL TO DEFAULTS
              </button>
            </div>
          </div>

        </div>
      </div>

    </section>
  </div>

  <!-- UNIVERSAL CRUD MODAL -->
  <div id="admin-crud-modal" class="fixed inset-0 z-[99999] bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto">
    <div class="bg-ivory border border-forest/20 shadow-2xl max-w-xl w-full my-8 p-6 md:p-8 relative">
      <div class="flex items-center justify-between border-b border-forest/15 pb-4 mb-6">
        <div>
          <span id="crud-modal-badge" class="text-[9px] tracking-widest uppercase text-gold font-semibold">ITEM EDITOR</span>
          <h3 id="crud-modal-title" class="font-display text-2xl text-forest mt-0.5">Edit Item</h3>
        </div>
        <button id="crud-modal-close" class="text-forest/60 hover:text-forest text-2xl leading-none px-2">&times;</button>
      </div>

      <form id="crud-modal-form" class="space-y-4">
        <input type="hidden" id="crud-item-id" />
        <input type="hidden" id="crud-item-type" />

        <div id="crud-dynamic-fields" class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
          <!-- Dynamically generated fields -->
        </div>

        <div class="flex justify-end gap-3 pt-6 border-t border-forest/15 mt-6">
          <button type="button" id="crud-modal-cancel" class="px-5 py-2.5 text-xs tracking-widest uppercase border border-forest/20 hover:border-forest">
            Cancel
          </button>
          <button type="submit" class="px-6 py-2.5 text-xs tracking-widest uppercase bg-forest text-white hover:bg-forest/90 font-medium">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="admin-toast" class="fixed bottom-6 right-6 z-[100000] bg-forest text-white px-6 py-3.5 shadow-xl text-xs tracking-widest uppercase border border-gold/40 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    Saved successfully!
  </div>
</BaseLayout>

<script>
  import {
    isAdminLoggedIn,
    loginAdmin,
    logoutAdmin,
    getSiteContent,
    loadSiteContent,
    saveSiteContent,
    resetSiteContentToDefault,
    type SiteContentStore,
  } from "../../utils/siteContentStorage";

  import {
    getAdminElements,
    loadAdminElements,
    saveAdminElements,
    resetAdminElementsToDefault,
    getContactSettings,
    loadContactSettings,
    saveContactSettings,
    type AdminElementsStore,
  } from "../../utils/itineraryStorage";
  import { fetchCmsPayload, saveCmsPayloadPatch, updateAdminPassword } from "../../utils/cmsBackend";

  // Data Stores
  let siteContent: SiteContentStore = getSiteContent();
  let itineraryElements: AdminElementsStore = getAdminElements();

  // Active States
  let activeSection: "website-content" | "itinerary-elements" | "site-settings" = "website-content";
  let activeWebsiteTab = "general";
  let activeItineraryTab = "hotels";

  // DOM Elements - Auth
  const loginView = document.getElementById("admin-login-view")!;
  const dashboardView = document.getElementById("admin-dashboard-view")!;
  const loginForm = document.getElementById("admin-login-form") as HTMLFormElement;
  const loginEmail = document.getElementById("login-email") as HTMLInputElement;
  const loginPassword = document.getElementById("login-password") as HTMLInputElement;
  const loginErrorMsg = document.getElementById("login-error-msg")!;
  const btnLogout = document.getElementById("btn-admin-logout")!;

  // DOM Elements - Navigation
  const sectionBtns = document.querySelectorAll<HTMLButtonElement>(".section-btn");
  const cmsSections = document.querySelectorAll<HTMLElement>(".cms-section");
  const websiteSubtabBtns = document.querySelectorAll<HTMLButtonElement>(".wtab-btn");
  const itineraryTabBtns = document.querySelectorAll<HTMLButtonElement>(".itab-btn");

  const websiteContentPanel = document.getElementById("website-content-panel")!;
  const itineraryItemsGrid = document.getElementById("itinerary-items-grid")!;
  const btnAddWebsiteItem = document.getElementById("btn-add-website-item")!;
  const btnAddItineraryElement = document.getElementById("btn-add-itinerary-element")!;

  // Toast
  const toast = document.getElementById("admin-toast")!;
  function showToast(msg: string) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove("translate-y-20", "opacity-0");
    setTimeout(() => {
      toast.classList.add("translate-y-20", "opacity-0");
    }, 2800);
  }

  function saveWithFeedback(save: Promise<unknown>, successMessage: string) {
    void save
      .then(() => showToast(successMessage))
      .catch((error: unknown) => {
        console.error("Could not save CMS changes:", error);
        showToast(error instanceof Error ? `Save failed: ${error.message}` : "Save failed.");
      });
  }

  // ========================
  // Authentication Handling
  // ========================
  async function loadAdminCmsData() {
    const payload = await fetchCmsPayload();
    siteContent = payload?.siteContent ? await loadSiteContent() : getSiteContent();
    itineraryElements = payload?.itineraryElements ? await loadAdminElements() : getAdminElements();
    const contactSettings = payload?.contactSettings ? await loadContactSettings() : getContactSettings();

    if (!payload?.siteContent || !payload?.itineraryElements || !payload?.contactSettings) {
      await saveCmsPayloadPatch({
        ...(!payload?.siteContent ? { siteContent } : {}),
        ...(!payload?.itineraryElements ? { itineraryElements } : {}),
        ...(!payload?.contactSettings ? { contactSettings } : {}),
      });
    }
  }

  async function checkAuth() {
    try {
      const authenticated = await isAdminLoggedIn();
      if (authenticated) {
        await loadAdminCmsData();
        loginView.classList.add("hidden");
        dashboardView.classList.remove("hidden");
        renderCurrentView();
      } else {
        loginView.classList.remove("hidden");
        dashboardView.classList.add("hidden");
      }
    } catch (error) {
      loginView.classList.remove("hidden");
      dashboardView.classList.add("hidden");
      loginErrorMsg.textContent = error instanceof Error ? error.message : "Could not connect to Supabase.";
      loginErrorMsg.classList.remove("hidden");
    }
  }

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    loginErrorMsg.classList.add("hidden");
    try {
      await loginAdmin(loginEmail.value, loginPassword.value);
      await loadAdminCmsData();
      loginView.classList.add("hidden");
      dashboardView.classList.remove("hidden");
      renderCurrentView();
      showToast("Welcome back, Administrator!");
    } catch (error) {
      loginErrorMsg.textContent = error instanceof Error ? error.message : "Could not sign in.";
      loginErrorMsg.classList.remove("hidden");
    }
  });

  btnLogout.addEventListener("click", async () => {
    if (confirm("Are you sure you want to log out of the Admin Dashboard?")) {
      try {
        await logoutAdmin();
        await checkAuth();
        showToast("Logged out successfully.");
      } catch (error) {
        showToast(error instanceof Error ? error.message : "Could not log out.");
      }
    }
  });

  // ========================
  // Section & Tab Switching
  // ========================
  sectionBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeSection = btn.dataset.section as any;
      sectionBtns.forEach((b) => {
        if (b.dataset.section === activeSection) {
          b.className = "section-btn px-4 py-2 text-xs tracking-widest uppercase font-semibold border transition-all border-gold bg-gold text-forest shadow-sm";
        } else {
          b.className = "section-btn px-4 py-2 text-xs tracking-widest uppercase font-semibold border transition-all border-white/20 text-white/70 hover:border-white hover:text-white";
        }
      });
      cmsSections.forEach((sec) => {
        if (sec.id === `section-${activeSection}`) {
          sec.classList.remove("hidden");
        } else {
          sec.classList.add("hidden");
        }
      });
      renderCurrentView();
    });
  });

  websiteSubtabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeWebsiteTab = btn.dataset.wtab!;
      websiteSubtabBtns.forEach((b) => {
        if (b.dataset.wtab === activeWebsiteTab) {
          b.className = "wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest bg-forest text-white font-medium";
        } else {
          b.className = "wtab-btn px-3 py-1.5 text-xs tracking-wider uppercase border border-forest/20 text-forest/70 hover:border-forest";
        }
      });
      renderWebsiteContentPanel();
    });
  });

  itineraryTabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeItineraryTab = btn.dataset.itab!;
      itineraryTabBtns.forEach((b) => {
        if (b.dataset.itab === activeItineraryTab) {
          b.className = "itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest bg-forest text-white font-medium";
        } else {
          b.className = "itab-btn px-4 py-2 text-xs tracking-widest uppercase border border-forest/20 text-forest/70 hover:border-forest";
        }
      });
      renderItineraryItemsGrid();
    });
  });

  function renderCurrentView() {
    if (activeSection === "website-content") {
      renderWebsiteContentPanel();
    } else if (activeSection === "itinerary-elements") {
      renderItineraryItemsGrid();
    } else if (activeSection === "site-settings") {
      loadSettingsTab();
    }
  }

  // ==========================================
  // Render Website Content CMS Sub-panels
  // ==========================================
  function renderWebsiteContentPanel() {
    // Show / hide "+ ADD" button for collections vs single forms
    if (["general", "about", "contact"].includes(activeWebsiteTab)) {
      btnAddWebsiteItem.classList.add("hidden");
    } else {
      btnAddWebsiteItem.classList.remove("hidden");
      btnAddWebsiteItem.textContent = `+ ADD ${activeWebsiteTab.toUpperCase().slice(0, -1)}`;
    }

    websiteContentPanel.innerHTML = "";

    if (activeWebsiteTab === "hotels" || activeWebsiteTab === "experiences") {
      const isHotels = activeWebsiteTab === "hotels";
      const heroKey = isHotels ? "hotelsHero" : "experienceHero";
      const hero = (siteContent as any)[heroKey];
      const pageName = isHotels ? "Hotels Page Hero" : "Experience Page Hero";
      const prefix = isHotels ? "hotels-hero" : "experience-hero";
      websiteContentPanel.innerHTML = `
        <form data-page-hero-form="${heroKey}" class="mb-8 max-w-4xl border border-forest/15 bg-white p-6 shadow-sm md:p-8">
          <div class="mb-6 border-b border-forest/10 pb-4">
            <h3 class="font-display text-2xl text-forest">${pageName}</h3>
            <p class="mt-1 text-xs text-stone-500">Configure the image or background video displayed at the top of this page.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-forest">Media Type</label>
              <select name="mediaType" class="w-full border border-forest/20 bg-ivory p-2.5 text-xs font-medium">
                <option value="image" ${hero.mediaType !== "video" ? "selected" : ""}>Static Image</option>
                <option value="video" ${hero.mediaType === "video" ? "selected" : ""}>Background Video</option>
              </select>
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-forest">Hero Image / Poster URL</label>
              <input type="url" name="image" value="${hero.image || ""}" class="w-full border border-forest/20 bg-ivory p-2.5 text-xs" placeholder="https://..." />
            </div>
          </div>
          <div class="mt-4">
            <label class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-forest">Hero Video URL</label>
