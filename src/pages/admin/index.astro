  // Save Modal Form Handler
  crudModalForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(crudModalForm);
    const type = crudItemType.value;
    const rawId = crudItemId.value;

    if (type.startsWith("website-")) {
      const tabKey = type.replace("website-", "");
      let collection: any[] = (siteContent as any)[tabKey] || [];
      const isEdit = rawId !== "";

      const newItem: any = {
        title: fd.get("title") as string,
        slug: (fd.get("slug") as string) || (fd.get("title") as string)?.toLowerCase().replace(/\s+/g, "-"),
        category: (fd.get("category") as string) || "LUXURY",
        image: fd.get("image") as string,
        description: fd.get("description") as string,
        question: fd.get("question") as string,
        answer: fd.get("answer") as string,
      };

      if (tabKey === "hotels") {
        newItem.location = (fd.get("location") as string) || "";
        newItem.airportDriveTime = (fd.get("airportDriveTime") as string) || "";
        newItem.nearbyHighlights = (fd.get("nearbyHighlights") as string) || "";
        newItem.facilities = Array.from({ length: 5 }, (_, index) => ({
          image: String(fd.get(`facilityImage${index}`) || "").trim(),
          description: String(fd.get(`facilityDescription${index}`) || "").trim(),
        })).filter((facility) => facility.image || facility.description);
      }

      if (tabKey === "journal") {
        const articleBody = (fd.get("body") as string) || "";
        newItem.body = articleBody
          .split(/\n\s*\n/)
          .map((paragraph) => paragraph.trim())
          .filter(Boolean);
      }

      if (tabKey === "events") {
        newItem.status = (fd.get("status") as string) || "upcoming";
        newItem.dateDisplay = (fd.get("dateDisplay") as string) || "";
        newItem.location = (fd.get("location") as string) || "Bali";
        newItem.link = (fd.get("link") as string) || "/contact/";
        newItem.badge = (fd.get("badge") as string) || "";
      }

      if (isEdit) {
        collection[Number(rawId)] = { ...collection[Number(rawId)], ...newItem };
      } else {
        collection.unshift(newItem);
      }

      (siteContent as any)[tabKey] = collection;
      try {
        await saveSiteContent(siteContent);
      } catch (error) {
        console.error("Could not save website item:", error);
        showToast(error instanceof Error ? `Save failed: ${error.message}` : "Could not save website item.");
        return;
      }
      renderWebsiteContentPanel();
      showToast("Website item saved!");
    } else if (type.startsWith("itinerary-")) {
      const itab = type.replace("itinerary-", "");
      const isEdit = rawId !== "";
      const elementId = rawId || `elem-${Date.now()}`;

      if (itab === "vehicles") {
        const newVeh = {
          id: elementId,
          name: fd.get("name") as string,
          capacityPax: Number(fd.get("capacityPax")) || 4,
          capacityLuggage: Number(fd.get("capacityLuggage")) || 4,
          category: "VIP VEHICLE",
          features: ["Captain Seats", "Wi-Fi", "Chauffeur"],
          image: (fd.get("image") as string) || "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=800&q=80",
          description: fd.get("description") as string,
        };
        const idx = itineraryElements.vehicles.findIndex((x) => x.id === elementId);
        if (idx >= 0) itineraryElements.vehicles[idx] = newVeh;
        else itineraryElements.vehicles.unshift(newVeh);
      } else if (itab === "activities") {
        const newActivity = {
          id: elementId,
          name: fd.get("title") as string,
          title: fd.get("title") as string,
          category: (fd.get("category") as string) || "",
          duration: (fd.get("duration") as string) || "",
          location: (fd.get("location") as string) || "",
          image: (fd.get("image") as string) || "",
          description: fd.get("description") as string,
        };
        const idx = itineraryElements.activities.findIndex((x) => x.id === elementId);
        if (idx >= 0) itineraryElements.activities[idx] = newActivity;
        else itineraryElements.activities.unshift(newActivity);
      } else {
        const itemObj = {
          id: elementId,
          name: fd.get("title") as string,
          title: fd.get("title") as string,
          category: fd.get("category") as string,
          image: fd.get("image") as string,
          description: fd.get("description") as string,
        };
        let targetArr: any[] = (itineraryElements as any)[itab] || [];
        const idx = targetArr.findIndex((x: any) => x.id === elementId);
        if (idx >= 0) targetArr[idx] = { ...targetArr[idx], ...itemObj };
        else targetArr.unshift(itemObj);
      }

      try {
        await saveAdminElements(itineraryElements);
      } catch (error) {
        console.error("Could not save itinerary element:", error);
        showToast(error instanceof Error ? `Save failed: ${error.message}` : "Could not save itinerary element.");
        return;
      }
      renderItineraryItemsGrid();
      showToast("Itinerary element saved!");
    }

    closeCrudModal();
  });

  // Delete Handlers
  async function deleteWebsiteItem(index: number) {
    if (!confirm("Are you sure you want to delete this website item?")) return;
    let collection: any[] = (siteContent as any)[activeWebsiteTab] || [];
    const previous = [...collection];
    collection.splice(index, 1);
    try {
      await saveSiteContent(siteContent);
    } catch (error) {
      (siteContent as any)[activeWebsiteTab] = previous;
      console.error("Could not delete website item:", error);
      showToast(error instanceof Error ? `Delete failed: ${error.message}` : "Could not delete website item.");
      return;
    }
    renderWebsiteContentPanel();
    showToast("Item deleted.");
  }

  async function deleteItineraryElement(id: string) {
    if (!confirm("Delete this itinerary element?")) return;
    let list: any[] = (itineraryElements as any)[activeItineraryTab] || [];
    const previous = [...list];
    (itineraryElements as any)[activeItineraryTab] = list.filter((x: any) => x.id !== id);
    try {
      await saveAdminElements(itineraryElements);
    } catch (error) {
      (itineraryElements as any)[activeItineraryTab] = previous;
      console.error("Could not delete itinerary element:", error);
      showToast(error instanceof Error ? `Delete failed: ${error.message}` : "Could not delete itinerary element.");
      return;
    }
    renderItineraryItemsGrid();
    showToast("Element deleted.");
  }

  // Initial Auth Check on Page Load
  checkAuth();
</script>
