---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allHotels = await getCollection('hotels');
  
  // Ambil semua kategori unik dari file-file MD
  const categories = [...new Set(allHotels.flatMap(hotel => hotel.data.categories))];

  return categories.map((category) => {
    const filteredHotels = allHotels.filter(hotel => 
      hotel.data.categories.includes(category)
    );
    return {
      params: { category },
      props: { hotels: filteredHotels },
    };
  });
}

const { category } = Astro.params;
const { hotels } = Astro.props;
---

<html lang="id">
<head>
  <title>Kategori: {category}</title>
</head>
<body>
  <h1>Hotel di Kategori: {category}</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {hotels.map(hotel => (
      <article class="border rounded-lg p-4 shadow">
        <img src={hotel.data.image || hotel.data.coverImage} alt={hotel.data.title} class="w-full h-48 object-cover rounded" />
        <h2 class="text-xl font-bold mt-2">{hotel.data.title}</h2>
        <p class="text-gray-600">{hotel.data.description}</p>
        <a href={`/hotels/${hotel.slug}`} class="inline-block mt-3 text-blue-600 font-semibold">
          Lihat Detail →
        </a>
      </article>
    ))}
  </div>
</body>
</html>