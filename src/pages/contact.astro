---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Tria Uma"
  description="Tell us about the journey you would love to experience."
>
  <section class="container-editorial grid gap-12 py-32 md:grid-cols-2 md:py-44">
    <div>
      <p class="mb-5 text-xs tracking-[0.25em] text-stone-500">CONTACT & RESERVATION</p>
      <h1 class="editorial-title text-6xl md:text-8xl">
        Let's plan something extraordinary.
      </h1>
      <p class="mt-7 max-w-md text-sm leading-8 text-stone-600">
        Tell us where you would like to go, what inspires you, and how
        you want to experience the world.
      </p>

      <div class="mt-12 space-y-6 border-t border-forest/15 pt-8 text-xs">
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">RESERVATION WHATSAPP</span>
          <a id="contact-page-wa" href="https://wa.me/6281234567890" target="_blank" class="font-medium text-forest hover:text-gold text-sm transition-colors flex items-center gap-2">
            <span>💬</span> <span id="contact-display-wa">+62 812 3456 7890</span>
          </a>
        </div>
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">EMAIL INQUIRIES</span>
          <a id="contact-page-email" href="mailto:reservation@triauma.com" class="font-medium text-forest hover:text-gold text-sm transition-colors">
            reservation@triauma.com
          </a>
        </div>
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">TELEPHONE</span>
          <p id="contact-display-phone" class="text-sm font-medium text-forest">
            +62 361 987 654
          </p>
        </div>
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">OFFICE ADDRESS</span>
          <p id="contact-display-address" class="text-stone-600 leading-relaxed max-w-sm">
            Jl. Danau Tamblingan No. 88, Sanur, Bali 80228, Indonesia
          </p>
        </div>
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">OFFICE HOURS</span>
          <p id="contact-display-hours" class="text-stone-600">
            Monday – Sunday, 08:00 – 20:00 WITA
          </p>
        </div>
        <div>
          <span class="text-[10px] tracking-widest text-gold uppercase font-semibold block mb-1">BESPOKE ITINERARY BUILDER</span>
          <a href="/plan-your-journey/" class="text-forest hover:text-gold font-medium underline">
            Build your custom day-to-day itinerary online ↗
          </a>
        </div>
      </div>
    </div>

    <form id="contact-inquiry-form" class="space-y-6">
      <label class="block text-xs tracking-widest">
        FULL NAME
        <input
          name="name"
          autocomplete="name"
          required
          class="mt-3 block w-full border-b border-stone-300 bg-transparent py-3 text-base outline-none focus:border-forest"
        />
      </label>

      <label class="block text-xs tracking-widest">
        EMAIL ADDRESS
        <input
          type="email"
          name="email"
          autocomplete="email"
          required
          class="mt-3 block w-full border-b border-stone-300 bg-transparent py-3 text-base outline-none focus:border-forest"
        />
      </label>

      <label class="block text-xs tracking-widest">
        DESTINATION OF INTEREST
        <input
          name="destination"
          placeholder="e.g. Bali, Komodo, Raja Ampat"
          class="mt-3 block w-full border-b border-stone-300 bg-transparent py-3 text-base outline-none focus:border-forest"
        />
      </label>

      <label class="block text-xs tracking-widest">
        TELL US ABOUT YOUR JOURNEY
        <textarea
          name="message"
          rows="5"
          required
          placeholder="Describe your travel dates, preferred hotels, special celebrations..."
          class="mt-3 block w-full resize-y border-b border-stone-300 bg-transparent py-3 text-base outline-none focus:border-forest"
        ></textarea>
      </label>

      <button
        type="submit"
        class="bg-forest px-8 py-4 text-xs tracking-widest text-white transition-colors hover:bg-gold"
      >
        SEND YOUR ENQUIRY ↗
      </button>

      <p class="text-xs leading-6 text-stone-500">
        By submitting this form, you agree to our privacy policy.
      </p>
      <div id="contact-form-response" class="hidden border border-forest/15 bg-sand/40 p-4 text-sm leading-6 text-forest" role="status" aria-live="polite">
        <p>Your email app should open with your inquiry ready to send. If it does not open, <a id="contact-email-fallback" class="font-semibold underline" href="#">send your inquiry by email</a>.</p>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  import { loadSiteContent } from "../utils/siteContentStorage";

  const form = document.getElementById("contact-inquiry-form") as HTMLFormElement | null;
  const response = document.getElementById("contact-form-response");
  const emailFallback = document.getElementById("contact-email-fallback") as HTMLAnchorElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const formData = new FormData(form);
    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const destination = String(formData.get("destination") || "").trim();
    const message = String(formData.get("message") || "").trim();
    let content: Awaited<ReturnType<typeof loadSiteContent>>;
    try {
      content = await loadSiteContent();
    } catch (error) {
      console.error("Could not load reservation contact details:", error);
      if (response) {
        response.textContent = "We could not load the reservation email address. Please refresh the page or contact us using the details above.";
        response.classList.remove("hidden");
      }
      return;
    }
    const contactEmail = content.contact.email;
    const subject = `Travel inquiry from ${name}`;
    const body = [
      "Hello Tria Uma,",
      "",
      "I would like to enquire about a journey.",
      "",
      `Full name: ${name}`,
      `Email: ${email}`,
      `Destination of interest: ${destination || "Not specified"}`,
      "",
      "Journey details:",
      message,
    ].join("\n");
    const mailtoUrl = `mailto:${encodeURIComponent(contactEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (emailFallback) emailFallback.href = mailtoUrl;
    response?.classList.remove("hidden");
    window.location.href = mailtoUrl;
  });
</script>
