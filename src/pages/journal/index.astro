---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("journal");
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Journal | Tria Uma" description="Stories, travel notes, and ideas for considered journeys.">
  <main class="container-editorial pb-24 pt-40 md:pt-52">
    <div id="journal-page-heading">
      <p class="text-xs tracking-[0.2em] text-stone-500">JOURNAL</p>
      <h1 class="editorial-title mt-4 text-5xl md:text-8xl">Stories from the road</h1>
    </div>

    <section id="cms-journal-detail" class="hidden w-full max-w-5xl py-16 text-sm leading-8 text-stone-600 md:text-lg">
      <a href="/journal/" class="inline-flex text-[10px] font-semibold uppercase tracking-[0.15em] text-forest hover:text-gold">← ALL STORIES</a>
      <p id="cms-journal-category" class="mt-10 text-[10px] tracking-[0.2em] text-stone-500"></p>
      <h2 id="cms-journal-title" class="editorial-title mt-4 max-w-5xl text-5xl md:text-8xl"></h2>
      <p id="cms-journal-description" class="mt-6 max-w-2xl text-sm leading-8 text-stone-600"></p>
      <img id="cms-journal-image" class="mt-10 max-h-[75vh] w-full object-cover" alt="" />
      <div id="cms-journal-body" class="mx-auto max-w-4xl py-16 text-base leading-8 text-stone-600 md:py-24 md:text-lg"></div>
    </section>

    <section id="related-journal-stories" class="hidden border-t border-forest/10 py-16 md:py-24">
      <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-[10px] tracking-[0.25em] text-gold">CONTINUE READING</p>
          <h2 class="editorial-title mt-3 text-4xl text-forest md:text-6xl">More stories from the road</h2>
        </div>
        <a href="/journal/" class="border-b border-forest/40 pb-2 text-[10px] font-semibold tracking-[0.15em] text-forest transition-colors hover:border-gold hover:text-gold">VIEW ALL STORIES ↗</a>
      </div>
      <div id="related-journal-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3"></div>
    </section>

    <div class="cms-journal-grid mt-16 grid gap-10 md:grid-cols-2 md:items-start">
      {entries.map((entry) => {
        const slug = entry.data.slug ?? entry.id;
        return (
          <a href={`/journal/${slug}/`} class="group">
            <div class="aspect-[4/3] overflow-hidden bg-stone-100">
              <img src={entry.data.image} alt={entry.data.title} class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]" />
            </div>
            <p class="mt-5 text-xs tracking-[0.2em] text-stone-500">{entry.data.category}</p>
            <h2 class="editorial-title mt-3 text-4xl">{entry.data.title}</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">{entry.data.description}</p>
          </a>
        );
      })}
    </div>
  </main>

  <script>
    import { getSiteContent } from "../../utils/siteContentStorage";

    const storySlug = new URLSearchParams(window.location.search).get("story");
    if (storySlug) {
      const detail = document.getElementById("cms-journal-detail");
      const grid = document.querySelector(".cms-journal-grid");
      const storedContent = getSiteContent();
      const story = storedContent.journal.find((item) => item.slug === storySlug);
      const pageHeading = document.getElementById("journal-page-heading");
      if (story && detail) {
        if (grid) grid.classList.add("hidden");
        if (pageHeading) pageHeading.classList.add("hidden");
        detail.classList.remove("hidden");
        document.getElementById("cms-journal-category")!.textContent = story.category || "JOURNAL";
        document.getElementById("cms-journal-title")!.textContent = story.title || "";
        document.getElementById("cms-journal-description")!.textContent = story.description || "";
        const image = document.getElementById("cms-journal-image") as HTMLImageElement;
        image.src = story.image || "";
        image.alt = story.title || "Journal story";
        const body = document.getElementById("cms-journal-body")!;
        const paragraphs = Array.isArray(story.body) ? story.body : story.description ? [story.description] : [];
        const escapeHtml = (value: unknown) => String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
        body.innerHTML = paragraphs.map((paragraph: string) => `<p>${escapeHtml(paragraph)}</p>`).join("");

        const relatedStories = storedContent.journal
          .filter((item) => item.slug !== story.slug)
          .slice(0, 3);
        const relatedSection = document.getElementById("related-journal-stories");
        const relatedGrid = document.getElementById("related-journal-grid");
        if (relatedGrid && relatedStories.length) {
          relatedGrid.innerHTML = relatedStories.map((item) => `
            <article class="group">
              <a href="/journal/?story=${encodeURIComponent(item.slug)}" class="block overflow-hidden bg-sand">
                <div class="aspect-[4/3] overflow-hidden">
                  <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
                </div>
              </a>
              <p class="mt-5 text-[10px] tracking-[0.2em] text-gold">${escapeHtml(item.category)}</p>
              <h3 class="mt-3 font-display text-3xl leading-tight text-forest">${escapeHtml(item.title)}</h3>
              <p class="mt-3 line-clamp-3 text-sm leading-7 text-stone-600">${escapeHtml(item.description)}</p>
              <a href="/journal/?story=${encodeURIComponent(item.slug)}" class="mt-5 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.15em] text-forest transition-colors hover:text-gold">LEARN MORE <span aria-hidden="true">↗</span></a>
            </article>
          `).join("");
          relatedSection?.classList.remove("hidden");
        }
        document.title = `${story.title} | JOURNAL`;
      }
    }
  </script>
</BaseLayout>
